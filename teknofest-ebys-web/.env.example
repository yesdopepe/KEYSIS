# EVREN çıkarım servisi (OpenAI uyumlu) — kullanım kılavuzu:
# https://evren-teknofest.ssyz.org.tr/hizli-baslangic
# Anahtar formatı: sk-evren-teamNN-XXXXXXXX. Platform (EVREN) girişinden
# bağımsızdır, bu servise özel bir anahtardır.
EVREN_API_KEY=
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1

# Gömme (embedding) modeli. Değiştirilirse src/lib/vektor/qdrant.ts
# içindeki VEKTOR_BOYUTU de güncellenmeli, ardından tüm Qdrant koleksiyonları
# yeniden oluşturulup mevcut içerik yeniden indekslenmelidir — farklı
# modellerin vektörleri karşılaştırılamaz.
#   embed        — 2560 boyut
#   bge-m3-embed — 1024 boyut, en yüksek R@1 doğruluğu (varsayılan)
EMBEDDING_MODEL=bge-m3-embed

# Optional per-agent model overrides. If unset, sensible defaults are used
# (see src/lib/ai/config.ts). Available EVREN chat models: `llm-large`
# (cultural/historical tasks, long reasoning chains, multimodal), `llm-fast`
# (terminology, document analysis), `router` (lightweight classification).
ROUTER_AGENT_MODEL=router
READER_AGENT_MODEL=llm-fast
WRITER_AGENT_MODEL=llm-large
EKSIK_BILGI_AGENT_MODEL=llm-fast
BELGE_YAZAR_AGENT_MODEL=llm-large

SESSION_SECRET=change-me-to-a-long-random-string

# Postgres connection string. A pooled Supabase URL (port 6543, PgBouncer
# transaction mode) works too — the db client already runs with prepared
# statements disabled (see src/lib/db/index.ts), which that mode requires.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Belge ayrıştırma servisi (services/docling-service). Varsayılan: yerelde
# npm run docling:dev. Başka bir makinede/sunucuda çalıştırırsanız buraya o
# adresi yazın (ör. http://10.0.0.5:8100) ve DOCLING_SHARED_SECRET'i doldurun
# — servis localhost dışından erişilebilir olduğunda /convert uçtan uca
# kimliksiz kalmasın diye (bkz. services/docling-service/main.py, Dockerfile).
DOCLING_SERVICE_URL=http://localhost:8100
DOCLING_SHARED_SECRET=

# Qdrant vektör veritabanı — varsayılan olarak EVREN'in barındırdığı,
# takım başına izole Qdrant örneği kullanılır. LLM anahtarından FARKLI bir
# anahtardır. QDRANT_PREFIX takım numaranızın URL yol öneki (ör. "team07").
QDRANT_URL=https://evren-vektor.ssyz.org.tr
QDRANT_API_KEY=
QDRANT_PREFIX=

# Yerelde çalıştırmak isterseniz (docker compose up -d qdrant ya da
# npm run qdrant:dev — bkz. README): QDRANT_URL=http://localhost:6333 yapıp
# QDRANT_API_KEY ve QDRANT_PREFIX'i boş bırakın.

# Kurum asistanı (sohbet + kurum belgelerinde arama). Araç çağrısını iyi
# destekleyen bir model seçin.
ASISTAN_AGENT_MODEL=llm-large

# Sohbette görsel ek olduğunda kullanılan model. Hem görsel girdiyi hem araç
# çağrısını desteklemesi gerekir; sadece görsel içeren sohbetlerde devreye
# girer, düz metin sohbetler ASISTAN_AGENT_MODEL ile çalışmaya devam eder.
# EVREN'in ayrı `vlm` modeli YALNIZCA video kabul eder, görseli tamamen
# reddeder — bu yüzden burada da llm-large kullanılıyor.
ASISTAN_GORSEL_AGENT_MODEL=llm-large

# Sohbet başlıklarını üreten küçük/ucuz model.
SOHBET_BASLIK_AGENT_MODEL=llm-fast
